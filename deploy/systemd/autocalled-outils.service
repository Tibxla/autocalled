# Outils d'agenda appelés par ElevenLabs, exposés par `tailscale funnel --https=10000`.
# Installation : scripts/installer-services.sh
[Unit]
Description=Autocalled, outils d'agenda
After=network-online.target

[Service]
WorkingDirectory=%h/projects/autocalled/apps/outils
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node --env-file=%h/projects/autocalled/.env src/serveur.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
