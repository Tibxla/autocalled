# Interface opérateur (Next.js), servie sur le tailnet par `tailscale serve --https=8449`.
# Modèle : scripts/installer-services.sh y écrit le dossier du dépôt (marqueur RACINE entre arobases) et le PATH
# qui mène à node, pnpm et claude (marqueur PATH entre arobases), puis l’installe dans ~/.config/systemd/user/.
[Unit]
Description=Autocalled, interface opérateur
After=network-online.target

[Service]
WorkingDirectory=@RACINE@/apps/web
Environment=NODE_ENV=production
Environment=PATH=@PATH@
ExecStart=@RACINE@/apps/web/node_modules/.bin/next start -H 127.0.0.1 -p 3020
Restart=on-failure
RestartSec=5
# Enregistrements au seul compte du service ; aucune élévation (sudo, setuid) depuis l'application ni depuis
# le `claude -p` qu'elle lance. Pas de ProtectHome : `claude` lit ~/.claude.
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=default.target
