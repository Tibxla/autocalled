# Durée de conservation (ADR 0014) : purge les données personnelles des appels passés DUREE_CONSERVATION_MOIS
# (enregistrements, transcriptions, texte des bilans) et le journal MCP ancien. Lancé par autocalled-purge.timer.
# Modèle : scripts/installer-services.sh y écrit le dossier du dépôt (marqueur RACINE entre arobases) et le PATH
# qui mène à node, pnpm et claude (marqueur PATH entre arobases), puis l’installe dans ~/.config/systemd/user/.. À la main : systemctl --user start autocalled-purge.service
[Unit]
Description=Autocalled, purge des données des appels passés la durée de conservation
After=network-online.target

[Service]
Type=oneshot
# Même copie que l'interface : le dossier de données (data/ à la racine, ou DOSSIER_DONNEES) est le sien.
WorkingDirectory=@RACINE@/apps/web
Environment=NODE_ENV=production
Environment=PATH=@PATH@
ExecStart=/usr/bin/env node --env-file=../../.env --conditions=react-server --import ./scripts/resolution.ts scripts/purger.ts
# Supprime des fichiers et des lignes : au seul compte du service, sans élévation (sudo, setuid), et jamais plus d'une heure.
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
TimeoutStartSec=1h
