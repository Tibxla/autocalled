# Copier en .env (puis chmod 600 .env : il porte des secrets) et remplir. Aucune valeur réelle ne doit être commitée.

# Identité Tailscale de l'opérateur (seule personne autorisée sur l'interface)
OPERATEUR_TAILSCALE_LOGIN=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Postgres (compose.yaml)
POSTGRES_PASSWORD=
DATABASE_URL=postgres://autocalled:MOT_DE_PASSE@127.0.0.1:5434/autocalled

# Développement uniquement : identité Tailscale simulée quand NODE_ENV=development, pour une requête locale directe
# (jamais une requête relayée par tailscale serve). À laisser vide dans le .env de production.
OPERATEUR_DEV_LOGIN=

# Calendrier où l'assistante crée les rendez-vous (identifiant, souvent une adresse e-mail). Les invitations partent au nom de son
# propriétaire : un calendrier partagé en modification avec le compte du connecteur Google Agenda de Claude convient.
AGENDA_CALENDRIER=

# Google Agenda : facultatif, le connecteur Google Agenda de Claude suffit (API directe, client « application Web »)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Adresse de l'interface sur le tailnet, obligatoire : seul cet hôte (ou 127.0.0.1) est servi, et la prise de main
# n'accepte que cette origine. L'URI de redirection Google est ORIGINE_APP/google/retour
ORIGINE_APP=https://NOM-DU-SERVEUR.TAILNET.ts.net:8449
# 32 octets en hexadécimal (openssl rand -hex 32) : chiffre le jeton Google en base
CLE_CHIFFREMENT=

# Liste d'opposition (ADR 0013) : sel secret des empreintes des numéros des personnes effacées (openssl rand -hex 32,
# 32 caractères au moins). Obligatoire pour effacer une personne. À NE JAMAIS CHANGER ni perdre une fois un effacement
# fait : les empreintes ne se retrouveraient plus, et plus aucun numéro ne serait appelé ni importé tant que l'ancienne
# valeur n'est pas remise. Distinct de CLE_CHIFFREMENT, qu'on peut changer sans rien casser ici.
SEL_OPPOSITION=

# Pont Bluetooth (ADR 0007) : secret partagé entre l'application et le pont, généré par scripts/installer-pont.sh
PONT_SECRET=
PONT_URL=http://127.0.0.1:3021
# Port HTTP du pont sur 127.0.0.1, à garder accordé à PONT_URL (3021 par défaut)
# PONT_PORT=3021
# WebSocket de prise de main (ADR 0008), exposé par tailscale serve sous /prise-en-main
PONT_PORT_WS=3022
# Valeurs par défaut des garde-fous de la ligne, ensuite réglés depuis la page Téléphone de l'application
PONT_APPELS_PAR_HEURE=15
PONT_APPELS_PAR_JOUR=50
PONT_PAUSE_ENTRE_APPELS_S=5
# Adresse locale de l'application, que le pont rappelle (le service autocalled-web écoute sur 127.0.0.1:3020)
WEB_URL=http://127.0.0.1:3020

# Serveur MCP (ADR 0010) : dossier agent/ lu et écrit par les outils de l'assistante. Par défaut, celui de la copie
# où tourne le serveur (apps/web/../../agent) ; à ne poser que pour pointer une autre copie.
# DOSSIER_AGENT=

# Dossier des enregistrements d'appels (par défaut data/ à la racine du dépôt)
# DOSSIER_DONNEES=

# Tests (vitest) : base dédiée, dont le nom finit par _test ; par défaut, autocalled_test sur le Postgres de DATABASE_URL
# DATABASE_URL_TEST=

# Analyseur : jeton longue durée issu de `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
