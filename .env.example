# Copier en .env et remplir. Aucune valeur réelle ne doit être commitée.

# Identité Tailscale de l'opérateur (seule personne autorisée sur l'interface)
OPERATEUR_TAILSCALE_LOGIN=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Secret partagé des outils webhook (agenda)
OUTILS_WEBHOOK_SECRET=

# Postgres (compose.yaml)
POSTGRES_PASSWORD=
DATABASE_URL=postgres://autocalled:MOT_DE_PASSE@127.0.0.1:5434/autocalled

# Développement uniquement : identité Tailscale simulée quand NODE_ENV=development
OPERATEUR_DEV_LOGIN=

# Google Agenda (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Analyseur : jeton longue durée issu de `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
